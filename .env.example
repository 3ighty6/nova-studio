# Copy to .env for `netlify dev`. On Netlify, set these under Site configuration → Environment variables.
# Never commit a real key.

# Required: your xAI API key (https://console.x.ai)
XAI_API_KEY=

# Optional: require this passcode (sent as the x-studio-passcode header) before the
# site will spend API credits. Strongly recommended for a public URL.
STUDIO_PASSCODE=

# Optional model overrides
# XAI_IMAGE_MODEL=grok-imagine-image-2.0
# XAI_TEXT_MODEL=grok-4.20-0309-non-reasoning

# Optional: point at a mock server for local tests
# XAI_BASE_URL=https://api.x.ai/v1
